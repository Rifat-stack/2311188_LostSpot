# Copy this file to backend/.env on your computer (never commit .env),
# and add the same names in Vercel -> Settings -> Environment Variables.

# Supabase "Transaction pooler" connection string (port 6543). Leave empty locally to use SQLite.
DATABASE_URL=

# Long random secrets. Make each one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
PASSWORD_PEPPER=

# Who may call the API from a browser. On Vercel, your site's address, e.g. https://your-app.vercel.app
FRONTEND_ORIGINS=http://localhost:5173

# Minutes an access token lasts (15 at most). Set it to 1 to show token expiry in the demo video.
ACCESS_TOKEN_MINUTES=15

# Test accounts shown on the login page (label|email|password, separated by ;).
# Only set this on Vercel, never write the passwords in the code. Leave empty to show none.
DEMO_LOGINS=
